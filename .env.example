# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GatePass backend / PostgreSQL connection
# Locally this points at the Node dev server (npm run server:dev). In a
# Vercel production build, set this to the deployed Render Node service URL
# instead — see VITE_SCANNER_API_BASE_URL below for why it can't be inferred.
VITE_API_BASE_URL="http://localhost:3001"
VITE_GOOGLE_CLIENT_ID="PASTE_GOOGLE_CLIENT_ID_HERE"
NODE_ENV="development"
PORT="3001"
PGHOST="127.0.0.1"
PGPORT="5432"
PGDATABASE="gatepass"
PGUSER="postgres"
PGPASSWORD=""
# Use the same Neon database as SCANNER_DATABASE_URL so public.* triggers can
# update scanner.* in the issuing transaction.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"
NEON_AUTH_URL="https://YOUR-NEON-AUTH-HOST/neondb/auth"
NEON_AUTH_AUDIENCE="YOUR_NEON_AUTH_AUDIENCE"

# Payment credentials belong in the deployment secret store. Never commit real
# keys, even test keys, to this file.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace_with_your_server_secret"

# ── GatePass Scanner service (FastAPI, Neon-backed scanner.* schema) ──
SCANNER_DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require"
SCANNER_MIGRATIONS_DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require"
GATEPASS_QR_SIGNING_KEY="GENERATE_A_STABLE_32PLUS_CHAR_SECRET"
GATEPASS_PUBLIC_APP_URL="http://localhost:5173"
GATEPASS_OWNER_EMAIL="ophardik001@gmail.com"
GATEPASS_GOOGLE_CLIENT_ID="PASTE_GOOGLE_CLIENT_ID_HERE"
GATEPASS_ADMIN_EMAILS="admin1@example.com,admin2@example.com"
# Locally this points at the FastAPI dev server (npm run scanner:dev). The
# FastAPI service is deployed separately on Render, on its own origin, so a
# Vercel production build must set this to that service's real URL — it is
# NOT the same origin as the web app. A loopback value is still ignored when
# the page is not on localhost — see src/apiBase.ts — because it can never be
# reached from a visitor's browser.
VITE_SCANNER_API_BASE_URL="http://127.0.0.1:8010"

# Optional self-hosted Nominatim-compatible reverse-geocoding endpoint.
VITE_GEOCODING_URL="https://nominatim.openstreetmap.org/reverse"
