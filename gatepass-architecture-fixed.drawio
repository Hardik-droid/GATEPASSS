        <mxCell id="schema-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#82b366;" edge="1" parent="1" source="schema-f" target="schema-v">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="image-p" value="Event-image upload returns 404" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="510" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="image-r" value="Frontend capability can exist even when the serverless entrypoint is absent/misrouted or SPA fallback captures the request." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="460" y="510" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="image-f" value="Use canonical /api/event-images → api/event-images.ts → server/app.ts. SPA fallback must not match /api/*. Keep function dependencies bundled." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="510" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="image-v" value="Post-deploy request to /api/event-images must reach the function: 2xx/4xx/401/403 are routable; route 404 or HTML SPA response fails release." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1570" y="510" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="image-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#82b366;" edge="1" parent="1" source="image-p" target="image-r">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="image-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#82b366;" edge="1" parent="1" source="image-r" target="image-f">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="image-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#82b366;" edge="1" parent="1" source="image-f" target="image-v">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-p" value="App state / reporting data truncates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="790" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="state-r" value="Persistence and reporting sync can diverge; destructive replacement or partial upserts can drop arrays/fields." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="460" y="790" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="state-f" value="One DB transaction: validate payload → write canonical app state → UPSERT reporting rows → commit once. No TRUNCATE/DELETE for omitted arrays. Preserve ticket ownership." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="790" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="state-v" value="Round-trip regression test preserves IDs, counts, arrays and ownership. Injected sync failure must roll back the entire write." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1570" y="790" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="state-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#82b366;" edge="1" parent="1" source="state-p" target="state-r">
          <mxGeometry relative="1" as="geometry" />
