          <mxGeometry x="950" y="120" width="560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="Validation / release gate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1570" y="120" width="500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="schema-p" value="Schema drift / half-deployed DB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="230" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="schema-r" value="Two DDL lifecycle paths: runtime ensureReady() and Alembic migration." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="460" y="230" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="schema-f" value="Alembic is the only DDL owner. ensureReady() checks connectivity + migration revision only. Local/dev runs alembic upgrade head before server start." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="230" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="schema-v" value="Fresh local DB and deployed DB reach the same Alembic head and same schema objects." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1570" y="230" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="schema-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#82b366;" edge="1" parent="1" source="schema-p" target="schema-r">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="schema-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#82b366;" edge="1" parent="1" source="schema-r" target="schema-f">
          <mxGeometry relative="1" as="geometry" />
